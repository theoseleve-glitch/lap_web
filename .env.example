# ──────────────────────────────────────────────
# Telemetry Analysis V2 — Environment Variables
# ──────────────────────────────────────────────
# Copy to .env and edit.  Lines starting with # are ignored.

# ── Flask ─────────────────────────────────────
TELEMETRY_SECRET_KEY=change-me-to-random-secret
TELEMETRY_HOST=127.0.0.1
TELEMETRY_PORT=5000
TELEMETRY_DEBUG=0
TELEMETRY_LOG_FORMAT=text

# ── Database ──────────────────────────────────
# SQLite (default, single-user / desktop)
TELEMETRY_DB_PATH=telemetry.db

# PostgreSQL (SaaS / multi-user) — set USE_PG=1 to activate
USE_PG=0
TELEMETRY_PG_URL=postgresql://telemetry:telemetry@localhost:5432/telemetry

# ── Redis + Celery ────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────
AUTH_REQUIRED=0
TELEMETRY_JWT_SECRET=change-me-to-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ── Ingest ────────────────────────────────────
# Streaming ingest pipeline (default ON). Set to 0 for legacy path.
TELEMETRY_INGEST_V2=1

# ── Email (Resend) ────────────────────────────
# Transactional email (auth, billing, support). Sender MUST be team@ for
# the paid launch — noreply@ is wrong. Read once in auth/email.py.
RESEND_API_KEY=
EMAIL_FROM=LAP <team@lap-coach.racing>
SUPPORT_EMAIL=support@lap-coach.racing
# Set EMAIL_SUPPRESS=1 in dev to log emails instead of sending them.
EMAIL_SUPPRESS=0

# ── Observability (Sentry) ────────────────────
# Sentry init is wired and DSN-gated; UNSET = no error reporting (launch
# flies blind). Set BOTH in production. DSNs come from the Sentry project.
# Backend (Flask API):   web/app.py
SENTRY_DSN_API=
# Celery workers:        celery_app.py
SENTRY_DSN_WORKER=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_RATE=0.1
# SENTRY_RELEASE is optional (e.g. the deploy git sha).
# Frontend DSN is NEXT_PUBLIC_SENTRY_DSN — set it in lap-website/.env.local
# (and at cf:build time), NOT here. See lap-website/src/lib/sentry.ts.

# ── GDPR ──────────────────────────────────────
TELEMETRY_EXPORT_DIR=/tmp/telemetry_exports

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_ENABLED=1

# ── Turnstile step-up challenge (login) ───────
# Closes the distributed-credential-stuffing residual left by the (email,
# IP)-scoped lockout (auth/lockout.py): when one email fails from many
# distinct IPs, /auth/login demands a passing Turnstile token before the
# password is even checked (auth/turnstile.py, auth/lockout.challenge_required).
# UNSET (either) = feature fully disabled, login behaves exactly as before.
# Secret key -- server-side only, calls challenges.cloudflare.com/siteverify.
TURNSTILE_SECRET_KEY=
# Public site key -- safe to expose; returned in the 428 challenge_required
# response as a fallback when the frontend's own NEXT_PUBLIC_TURNSTILE_SITEKEY
# (see lap-website/.env.local.example) isn't set at build time.
TURNSTILE_SITEKEY=

# ── CORS ──────────────────────────────────────
# MUST include the annotator origin (ANNOTATOR_HOST, see Track Onboarding
# Loop section below) or the annotator webapp's browser fetch fails CORS.
CORS_ALLOWED_ORIGINS=https://www.lap-coach.racing,https://lap-coach.racing

# ── Track Onboarding Loop ─────────────────────
# Automated GT-onboarding when a session's pipeline can't resolve boundary
# geometry for its track. See docs/runbooks/track-onboarding.md.
# HMAC secret signing the one-shot annotator token. FAILS CLOSED if unset —
# no draft email can go out and no /save can be authorized. Generate with:
#   openssl rand -hex 32
ONBOARDING_TOKEN_SECRET=
# Recipient of the draft-ready operator notification email.
ONBOARDING_OPERATOR_EMAIL=
# Base URL of the annotator webapp; the emailed link is
# {ANNOTATOR_HOST}/?req=<id>#token=<raw_token>. Must also be listed in
# CORS_ALLOWED_ORIGINS above or the annotator's browser fetch fails CORS.
ANNOTATOR_HOST=
# Durable, persistent-volume directory for blessed runtime GT geometry.
GT_RUNTIME_DIR=/data/gt_runtime
# Durable, persistent-volume directory for auto-drafted (pre-bless) geojson.
ONBOARDING_DRAFT_DIR=/data/onboarding_drafts
# Optional: path to the sibling trackreco-main checkout (SAM2 draft script).
# Unset = drafting degrades to a GPS-only centerline draft (never raises).
ONBOARDING_TRACKRECO_DIR=
# Optional: one-shot annotator token lifetime in hours. Default: 72.
ONBOARDING_TOKEN_TTL_HOURS=

# ── Next.js Frontend ─────────────────────────
# The following variable is NOT used by this backend.
# It goes in the lap-website/.env.local file for the Next.js frontend.
# NEXT_PUBLIC_API_URL=https://api.lap-coach.racing
