# ──────────────────────────────────────────────
# Telemetry Analysis V2 — Environment Variables
# ──────────────────────────────────────────────
# Copy to .env and edit.  Lines starting with # are ignored.

# ── Flask ─────────────────────────────────────
TELEMETRY_SECRET_KEY=change-me-to-random-secret
TELEMETRY_HOST=127.0.0.1
TELEMETRY_PORT=5000
TELEMETRY_DEBUG=0
TELEMETRY_LOG_FORMAT=text

# ── Database ──────────────────────────────────
# SQLite (default, single-user / desktop)
TELEMETRY_DB_PATH=telemetry.db

# PostgreSQL (SaaS / multi-user) — set USE_PG=1 to activate
USE_PG=0
TELEMETRY_PG_URL=postgresql://telemetry:telemetry@localhost:5432/telemetry

# ── Redis + Celery ────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────
AUTH_REQUIRED=0
TELEMETRY_JWT_SECRET=change-me-to-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ── Ingest ────────────────────────────────────
# Streaming ingest pipeline (default ON). Set to 0 for legacy path.
TELEMETRY_INGEST_V2=1

# ── GDPR ──────────────────────────────────────
TELEMETRY_EXPORT_DIR=/tmp/telemetry_exports

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_ENABLED=1

# ── CORS ──────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://www.lap-coach.racing,https://lap-coach.racing

# ── Next.js Frontend ─────────────────────────
# The following variable is NOT used by this backend.
# It goes in the lap-website/.env.local file for the Next.js frontend.
# NEXT_PUBLIC_API_URL=https://api.lap-coach.racing
