# ──────────────────────────────────────────────
# lap-website — Next.js Environment Variables
# ──────────────────────────────────────────────
# Copy to .env.local and edit.

# Flask API backend URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Stripe (billing pages)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe price IDs (create products in Stripe dashboard, copy price IDs here)
STRIPE_PRICE_PERFORMANCE_MONTHLY=price_...
STRIPE_PRICE_PERFORMANCE_ANNUAL=price_...
STRIPE_PRICE_PRO_RACER_MONTHLY=price_...
STRIPE_PRICE_PRO_RACER_ANNUAL=price_...

# Lead delivery (B2B forms)
CRM_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=
LEAD_WEBHOOK_BEARER=
CONVERSION_WEBHOOK_URL=

# Sentry error monitoring (wired in src/lib/sentry.ts; UNSET = no reporting).
# Set at build time for production (cf:build) so it's inlined into the client.
NEXT_PUBLIC_SENTRY_DSN=

# OAuth (optional, for social login)
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
