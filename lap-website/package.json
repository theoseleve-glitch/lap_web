{
  "name": "lap-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node scripts/check-marketing-assets.mjs --clean-start",
    "health:assets": "node scripts/check-marketing-assets.mjs",
    "dev:reset": "node scripts/check-marketing-assets.mjs --reset",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "next lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:vitest": "vitest run src/__tests__/journeys.e2e.test.tsx",
    "qa:content": "node scripts/content-qa.mjs",
    "lint:copy": "node scripts/lint-duplicate-copy.mjs",
    "lint:cta": "node scripts/lint-cta-count.mjs",
    "lint:standards": "node scripts/lint-copy-standards.mjs",
    "lint:links": "node scripts/lint-internal-links.mjs",
    "lint:placeholders": "node scripts/lint-placeholders.mjs",
    "lint:feature-case": "node scripts/lint-feature-case.mjs",
    "lint:i18n-ready": "node scripts/lint-i18n-ready.mjs",
    "lint:page-template": "node scripts/lint-page-template.mjs",
    "lint:benefits": "node scripts/lint-benefits.mjs",
    "lint:cta-text": "node scripts/lint-cta-text.mjs",
    "lint:plan-names": "node scripts/lint-plan-names.mjs",
    "lint:faq": "node scripts/lint-faq.mjs",
    "lint:design-tokens": "node scripts/lint-design-tokens.mjs",
    "lint:icon-imports": "node scripts/lint-icon-imports.mjs",
    "lint:typography": "node scripts/lint-typography.mjs",
    "lint:headings": "node scripts/lint-heading-hierarchy.mjs",
    "lint:spacing": "node scripts/lint-spacing-tokens.mjs",
    "lint:routes": "node scripts/lint-route-map.mjs",
    "lint:nav": "node scripts/lint-nav-overrides.mjs",
    "lint:spelling": "npx cspell \"src/**/*.{tsx,ts,mdx}\" --no-progress --no-must-find-files",
    "test:visual": "playwright test e2e/visual-regression.spec.ts",
    "test:visual:update": "playwright test e2e/visual-regression.spec.ts --update-snapshots",
    "scan:inventory": "node scripts/scan-content-inventory.mjs",
    "ci": "npm run lint && npm run test && npm run build && npm run qa:content && npm run lint:copy && npm run lint:cta && npm run lint:cta-text && npm run lint:standards && npm run lint:links && npm run lint:benefits && npm run lint:plan-names && npm run lint:placeholders && npm run lint:design-tokens && npm run lint:typography && npm run lint:icon-imports && npm run lint:nav && npm run lint:headings && npm run lint:spacing && npm run lint:routes && npm run ci:assert-site-url",
    "ci:assert-site-url": "node scripts/assert-no-legacy-domain.mjs",
    "qa:sitemap-preview": "node scripts/check-sitemap-preview.mjs",
    "ci:preview": "npm run qa:sitemap-preview"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@opennextjs/cloudflare": "^1.15.1",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@sentry/browser": "^10.40.0",
    "@tanstack/react-query": "^5.90.21",
    "gsap": "^3.14.2",
    "howler": "^2.2.4",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.17",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "three": "^0.183.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/howler": "^2.2.12",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jsdom": "^28.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "wrangler": "^4.69.0"
  }
}
